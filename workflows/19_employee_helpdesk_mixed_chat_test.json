    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "nodeGroups": [
    {
      "name": "One chat, IT and HR mixed",
      "nodeNames": [
        "New Test Session",
        "T1 Greeting",
        "T2 IT Problem With Email",
        "T3 HR Question",
        "T4 HR Follow Up",
        "T5 IT Unknown Problem",
        "T6 Short Follow Up",
        "T7 Out Of Scope",
        "Collect Replies"
      ],
      "description": "One session switches between IT and HR. Checks routing, follow-ups, the shared email and an out-of-scope question."
    }
  ],
  "meta": {
