      "description": "Masks PII before the router model sees the message and blocks clear prompt-injection attempts."
    },
    {
      "name": "Router",
      "nodeNames": [
        "Load Session Route",
        "Classify Topic",
        "Claude Haiku",
        "Decide Route",
        "Save Route",
        "Route to Specialist"
      ],
      "description": "Claude labels the message IT, HR, follow-up or other. Code sends follow-ups such as yes to the last specialist."
