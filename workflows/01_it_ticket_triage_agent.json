    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ticket_log (dedupe_key, from_email, subject, body, status, received_at)\nVALUES ($1::text, $2::text, $3::text, $4::text, 'processing', $5::timestamptz)\nON CONFLICT (dedupe_key) DO UPDATE\n  SET status = 'processing', attempts = ticket_log.attempts + 1, updated_at = now()\n  WHERE ticket_log.status = 'processing' AND ticket_log.updated_at < now() - interval '15 minutes'\nRETURNING id, attempts;",
        "options": {
          "connectionTimeout": 15,
          "queryReplacement": "={{ [$('Normalize Ticket').first().json.dedupe_key, $('Normalize Ticket').first().json.from, $('Guard Ticket Text').first().json.safe_subject, $('Guard Ticket Text').first().json.safe_body, $('Normalize Ticket').first().json.received_at] }}"
        }
