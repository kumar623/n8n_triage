      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "notes": "Idempotency. One row per dedupe key. A second copy of the same ticket returns no row, so it is treated as a duplicate. A row stuck in 'processing' for 15 minutes can be claimed again.",
      "credentials": {
        "postgres": {
          "id": "oLLrgw5SvNsom6qE",
          "name": "Postgres account 2"
        }
